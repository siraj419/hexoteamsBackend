# Copy to .env and fill in real values. Pydantic reads env vars (see app/core/config.py).

# --- App ---
APP_NAME=HexoTeams API
APP_VERSION=1.0.0
APP_PORT=8002

# Public frontend URL (emails, invitation links, notifications)
FRONTEND_URL=http://localhost:5173

# --- Database (async SQLAlchemy; sync code uses postgresql:// derived from this) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hexoteams

# --- JWT (HS256; secret must be at least 32 characters) ---
JWT_SECRET_KEY=change-me-use-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
JWT_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
# Optional: MinIO, LocalStack, etc.
# S3_ENDPOINT_URL=http://localhost:9000
S3_USE_SSL=true
S3_SIGNATURE_VERSION=s3v4
S3_MAX_FILE_SIZE_MB=100
S3_PUBLIC_READ=false
S3_PRESIGNED_URL_EXPIRATION=3600
# Optional override (JSON array). If unset, defaults apply in code.
# S3_ALLOWED_EXTENSIONS_LIST=["jpg","jpeg","png","pdf"]

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true
FROM_EMAIL=noreply@example.com
FROM_NAME=HexoTeams

# --- Redis (cache + Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# --- Optional tuning (defaults shown) ---
EMAIL_TEMPLATES_PATH=app/templates
DEFAULT_PAGINATION_LIMIT=10
DEFAULT_PAGINATION_OFFSET=0
INVITATION_TOKEN_EXPIRATION_HOURS=24
MAX_COMMENT_REPLY_DEPTH=3
MAX_SUBTASK_DEPTH=3
